## Local SDK Configuration Example
# Copy this file to 'local.properties' and adjust the paths/values for your local environment.
#
# Windows:
# sdk.dir=C\:\\Users\\YourUsername\\AppData\\Local\\Android\\Sdk
#
# macOS:
# sdk.dir=/Users/YourUsername/Library/Android/sdk
#
# Linux:
# sdk.dir=/home/YourUsername/Android/Sdk

## Optional Release Signing Credentials (NEVER commit local.properties to git!)
# KEYSTORE_PATH=C\:\\path\\to\\your-release-key.jks
# STORE_PASSWORD=your_store_password
# KEY_ALIAS=your_key_alias
# KEY_PASSWORD=your_key_password
